PORT=3373
WHISPER_MODEL=large-v3-turbo
LOG_LEVEL=INFO
DEVICE=auto
COMPUTE_TYPE=int8
LOG_FILE=logs/whisper.log
QUEUE_MAX_SIZE=8
DEFAULT_TIMEOUT_SECONDS=180
MAX_UPLOAD_MB=50
VAD_FILTER=true
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_DURATION_MS=500
VAD_SPEECH_PAD_MS=200
CONDITION_ON_PREVIOUS_TEXT=false
REPETITION_PENALTY=1.1
NO_REPEAT_NGRAM_SIZE=3
COMPRESSION_RATIO_THRESHOLD=2.2
LOG_PROB_THRESHOLD=-1.0
NO_SPEECH_THRESHOLD=0.6
TEMPERATURE_FALLBACK=true
HALLUCINATION_SILENCE_THRESHOLD=1.0
CPU_THREADS=0
# Idle seconds before the model is unloaded and its VRAM released. 0 keeps it loaded.
MODEL_UNLOAD_SECONDS=60
# Let /health probe a sleeping model. Keep false so that health checks more
# frequent than MODEL_UNLOAD_SECONDS do not keep the model resident forever;
# GET /health?wake=true still forces a full probe.
HEALTH_WAKE_MODEL=false
# Fall back to CPU inference when CUDA has no memory left (shared GPU).
CUDA_OOM_FALLBACK_CPU=true
# Model used by that fallback. WHISPER_MODEL is sized for the GPU and is far
# slower than real time on CPU. Empty keeps WHISPER_MODEL.
CPU_FALLBACK_MODEL=small
# Compute type for CPU runs. GPU-only types (int8_float16, float16) have no CPU
# kernels in CTranslate2.
CPU_FALLBACK_COMPUTE_TYPE=int8
# Optional. When set, requests must include:
# Authorization: Bearer <API_TOKEN>
API_TOKEN=
# Backward-compatible alias used by bratishkabot-whisper-server.
# API_TOKEN takes precedence when both variables are set.
API_KEY=
